  "evidencePolicy": {
    "summary": {
      "en": "Estimated defaults and user inputs feed calculated results. No live prices, measured performance or universal winner.",
      "tr": "Tahmini varsayımlar ve kullanıcı girdileri hesaplanmış sonuçları besler. Canlı fiyat, ölçülmüş performans veya evrensel kazanan yoktur."
    },
    "allowedKinds": [
      "estimated",
      "user-input",
      "calculated"
    ]
  },
  "assumptions": [
    {
      "id": "educational-defaults",
      "title": {
        "en": "Educational defaults",
        "tr": "Eğitim varsayımları"
      },
      "description": {
        "en": "Prices, utilization and capacity inputs are editable educational assumptions, not live quotes or measured throughput. Candidate-level source and unknown labels remain authoritative.",
        "tr": "Fiyat, kullanım ve kapasite girdileri değiştirilebilir eğitim varsayımlarıdır; canlı teklif veya ölçülmüş hız değildir. Seçeneklerin kaynak ve bilinmeyen etiketleri geçerlidir."
      }
    },
    {
      "id": "bounded-model",
      "title": {
        "en": "Bounded decision model",
        "tr": "Sınırlı karar modeli"
      },
      "description": {
        "en": "Peak memory uses simplified weight and full-attention KV formulas. Cost uses fixed demand; taxes, labor, financing, depreciation and residual value are excluded. Eligibility is separate from preference ranking.",
        "tr": "Tepe bellek basitleştirilmiş ağırlık ve tam dikkat KV formüllerini kullanır. Maliyet sabit talebe dayanır; vergi, emek, finansman, amortisman ve kalıntı değer dışarıdadır. Uygunluk tercih sıralamasından ayrıdır."
      }
    }
  ],
  "evidence": [
    {
      "schemaVersion": "0.1",
      "id": "defaults",
      "kind": "estimated",
      "verificationStatus": "unverified",
      "label": {
        "en": "Price and capacity defaults",
        "tr": "Fiyat ve kapasite varsayımları"
      },
      "notes": {
        "en": "Educational estimates carry no verification of current market prices or serving performance.",
        "tr": "Eğitim tahminleri güncel piyasa fiyatını veya servis performansını doğrulamaz."
      },
      "assumptionRefs": [
        "educational-defaults",
        "bounded-model"
      ]
    },
    {
      "schemaVersion": "0.1",
      "id": "inputs",
      "kind": "user-input",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Workload and overrides",
        "tr": "İş yükü ve değişiklikler"
      },
      "notes": {
        "en": "User edits and selected presets define the current calculation; changing a scenario can retain price overrides.",
        "tr": "Kullanıcı düzenlemeleri ve seçilen önayar mevcut hesabı belirler; senaryo değişimi fiyat düzenlemelerini koruyabilir."
      },
      "assumptionRefs": [
        "educational-defaults",
        "bounded-model"
      ]
    },
    {
      "schemaVersion": "0.1",
      "id": "results",
      "kind": "calculated",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Memory, cost and eligibility",
        "tr": "Bellek, maliyet ve uygunluk"
      },
      "notes": {
        "en": "Results follow the displayed inputs and formulas. A calculated ranking is conditional, not a universal purchase recommendation.",
        "tr": "Sonuçlar gösterilen girdileri ve formülleri izler. Hesaplanan sıralama koşulludur; evrensel satın alma önerisi değildir."
      },
      "assumptionRefs": [
        "educational-defaults",
        "bounded-model"
      ],
      "calculatedFrom": [
        "defaults",
        "inputs"
      ]
    }
  ],
